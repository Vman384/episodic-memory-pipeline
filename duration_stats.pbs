#!/bin/bash
#PBS -N episodic_duration_stats
#PBS -P pg06
#PBS -q copyq
#PBS -l ncpus=1
#PBS -l mem=4GB
#PBS -l walltime=00:30:00
#PBS -l storage=gdata/pg06
#PBS -l wd
#PBS -j oe

set -euo pipefail

module load python3/3.11.7

cd "${PBS_O_WORKDIR:?Submit this job from the repository directory}"

python3 generate_duration_stats.py \
  --data-root /g/data/pg06/FYP2026S1_3473 \
  --tex-output duration_stratified_table.tex \
  --csv-output duration_stratified_stats.csv
