#!/bin/bash
#PBS -N boreas_dataset_download
#PBS -P pg06
#PBS -q copyq
#PBS -l ncpus=1
#PBS -l mem=8GB
#PBS -l walltime=4:00:00
#PBS -l storage=scratch/pg06+gdata/pg06
#PBS -l wd


set -e  # Exit immediately if a command fails

module load python3/3.11.7

cd "$PBS_O_WORKDIR"

# run script for awscli
source .venv/bin/activate

DESTINATION="/g/data/pg06/FYP2026S1_3473/boreas_dataset"
mkdir -p "$DESTINATION"

echo "Starting download into $DESTINATION..."

for d in \
    boreas-2025-02-21-14-51 \
    boreas-2025-02-15-17-19 \
    boreas-2024-12-04-14-59 \
    boreas-2025-07-18-10-33 \
    boreas-2025-02-22-12-26 \
    boreas-2025-08-13-10-36; do
     aws s3 sync "s3://boreas/$d" "$DESTINATION/$d" \
        --exclude "*" --include "camera/*" --no-sign-request
done

echo "Download completed."
