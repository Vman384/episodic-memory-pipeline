#!/bin/bash
#PBS -N sparse_event
#PBS -P pg06
#PBS -q dgxa100
#PBS -l ncpus=64
#PBS -l ngpus=4
#PBS -l mem=1024GB
#PBS -l walltime=05:00:00
#PBS -l storage=scratch/pg06
#PBS -l wd

module load python3/3.11.7
module load cuda/12.2.2

# cd to the right directory
cd "$PBS_O_WORKDIR"

# enter virutal environment for dependencies
source /scratch/pg06/vm4618/envs/vllm_env/bin/activate

# export for running local llm
export HF_HOME="/scratch/pg06/FYP2026S1_3473/huggingface_cache"

# export for running API calls
source "$PBS_O_WORKDIR/.env"
export OPENCODE_API_KEY

if [[ -z "$OPENCODE_API_KEY" ]]; then
    echo "OPENCODE_API_KEY is not set"
    exit 1
fi

# 2. Fix C++ Header Paths (Missing Python.h)
export CPATH="/apps/python3/3.11.7/include/python3.11:$(python3 -c "import sysconfig; print(sysconfig.get_path('include'))"):$CPATH"
export CPLUS_INCLUDE_PATH=$CPATH

# 3. Fix CUDA Compiler Paths (FlashInfer JIT / nvcc)
export CUDA_HOME=/apps/cuda/12.2.2
export PATH=$CUDA_HOME/bin:$PATH

# 4. Direct PyTorch JIT Cache to Fast Local Node Storage
export TORCH_EXTENSIONS_DIR="${PBS_JOBFS:-/tmp}/torch_extensions"
export VLLM_ATTENTION_BACKEND=FLASH_ATTN

# run main script
python3 main.py --mode sparse
